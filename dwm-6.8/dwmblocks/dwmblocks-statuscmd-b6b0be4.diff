From: local
Subject: [PATCH] dwmblocks statuscmd matched to dwm SIGRTMIN protocol

Prefix each block with its signal byte. On SIGRTMIN+N with a button
value, rerun that block with BLOCK_BUTTON and BUTTON set. A bare
pkill -RTMIN+N still refreshes.

--- a/dwmblocks.c
+++ b/dwmblocks.c
@@ -25,12 +25,13 @@
 	unsigned int signal;
 } Block;
 #ifndef __OpenBSD__
 void dummysighandler(int num);
 #endif
 void sighandler(int num);
+void buttonhandler(int sig, siginfo_t *si, void *ucontext);
 void getcmds(int time);
 void getsigcmds(unsigned int signal);
 void setupsignals();
 void sighandler(int signum);
 int getstatus(char *str, char *last);
 void statusloop();
@@ -49,26 +50,41 @@
 
 
