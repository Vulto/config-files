 		return;
 	int i = strlen(block->icon);
-	fgets(tempstatus+i, CMDLENGTH-i-delimLen, cmdf);
+	fgets(tempstatus + off + i, CMDLENGTH - off - i - delimLen, cmdf);
 	i = strlen(tempstatus);
 	//if block and command output are both not empty
 	if (i != 0) {
 		//only chop off newline if one is present at the end
 		i = tempstatus[i-1] == '\n' ? i-1 : i;
 		if (delim[0] != '\0') {
@@ -100,21 +116,29 @@
 			getcmd(current,statusbar[i]);
 	}
 }
 
 void setupsignals()
 {
+	struct sigaction sa;
+
+	sigemptyset(&sa.sa_mask);
+	sa.sa_sigaction = buttonhandler;
+	sa.sa_flags = SA_SIGINFO;
 #ifndef __OpenBSD__
-	    /* initialize all real time signals with dummy handler */
-    for (int i = SIGRTMIN; i <= SIGRTMAX; i++)
-        signal(i, dummysighandler);
+	/* initialize all real time signals with dummy handler */
+	for (int i = SIGRTMIN; i <= SIGRTMAX; i++)
+		signal(i, dummysighandler);
 #endif
 
-	for (unsigned int i = 0; i < LENGTH(blocks); i++)
-		if (blocks[i].signal > 0)
-			signal(SIGMINUS+blocks[i].signal, sighandler);
+	for (unsigned int i = 0; i < LENGTH(blocks); i++) {
+		if (blocks[i].signal > 0) {
+			sigaddset(&sa.sa_mask, SIGRTMIN + blocks[i].signal);
+			sigaction(SIGRTMIN + blocks[i].signal, &sa, NULL);
+		}
+	}
 }
 
 int getstatus(char *str, char *last)
 {
 	strcpy(last, str);
 	str[0] = '\0';
@@ -172,12 +196,22 @@
 #ifndef __OpenBSD__
 /* this signal handler should do nothing */
 void dummysighandler(int signum)
 {
     return;
 }
+
+void buttonhandler(int sig, siginfo_t *si, void *ucontext)
+{
+	int btn = si ? si->si_value.sival_int : 0;
+
+	if (btn)
+		*button = '0' + (btn & 0xff);
+	getsigcmds(sig - SIGRTMIN);
+	writestatus();
+}
 #endif
 
 void sighandler(int signum)
 {
 	getsigcmds(signum-SIGPLUS);
 	writestatus();
