From: local
Subject: [PATCH] bottomdockgap adapted for dwm 6.8 + prior patches

Reserve bottom_gap under the window area while gaps are on, like the
bar. Toggling gaps off (or a tag without gaps) grows windows into
that strip. Fullscreen still covers it.

--- a/config.h
+++ b/config.h
@@ -8,12 +8,13 @@
 
 /* appearance */
 static const unsigned int borderpx  = 0;        /* border pixel of windows */
 static const int startwithgaps[]    = { 1 };	/* 1 means gaps are used by default, this can be customized for each tag */
 static const unsigned int gappx[]   = { 10 };   /* default gap between windows in pixels, this can be customized for each tag */
 static const unsigned int snap      = 20;       /* snap pixel */
+static const unsigned int bottom_gap = 50;      /* reserved pixels under tiled windows */
 static const int showbar            = 1;        /* 0 means no bar */
 static const int topbar             = 1;        /* 0 means bottom bar */
 static const int user_bh            = 30;        /* 0 means that dwm will calculate bar height, >= 1 means dwm will user_bh as bar height */
 static const double activeopacity   = 1.0f;     /* Window opacity when it's focused (0 <= opacity <= 1) */
 static const double inactiveopacity = 0.675f;   /* Window opacity when it's inactive (0 <= opacity <= 1) */
 static       Bool bUseOpacity       = False;     /* Starts with opacity on any unfocused windows */
--- a/dwm.c
+++ b/dwm.c
@@ -1994,12 +1994,13 @@
 		default:
 			if (selmon->pertag->gappx[selmon->pertag->curtag] + arg->i < 0)
 				selmon->pertag->gappx[selmon->pertag->curtag] = 0;
 			else
 				selmon->pertag->gappx[selmon->pertag->curtag] += arg->i;
 	}
+	updatebarpos(selmon);
 	arrange(selmon);
 }
 
 Layout *last_layout;
 void
 fullscreen(const Arg *arg)
@@ -2522,12 +2523,14 @@
 	if (m->showbar) {
 		m->wh = m->wh - vertpad - bh;
 		m->by = m->topbar ? m->wy : m->wy + m->wh + vertpad;
 		m->wy = m->topbar ? m->wy + bh + vp : m->wy;
 	} else
 		m->by = -bh - vp;
+	if (m->pertag && m->pertag->drawwithgaps[m->pertag->curtag])
+		m->wh -= bottom_gap;
 }
 
 void
 updateclientlist(void)
 {
 	Client *c;
@@ -2774,12 +2777,13 @@
 	selmon->lt[selmon->sellt] = selmon->pertag->ltidxs[selmon->pertag->curtag][selmon->sellt];
 	selmon->lt[selmon->sellt^1] = selmon->pertag->ltidxs[selmon->pertag->curtag][selmon->sellt^1];
 
 	if (selmon->showbar != selmon->pertag->showbars[selmon->pertag->curtag])
 		togglebar(NULL);
 
+	updatebarpos(selmon);
 	focus(NULL);
 	arrange(selmon);
 }
 
 Client *
 wintoclient(Window w)
