From: local
Subject: [PATCH] st autodarkmode matched to dwm PaperColor toggle

Two palettes (current dark + PaperColor light). Startup and
ST_COLORMODE ClientMessage reload ~/.config/dwm/.lightmode.

--- a/config.h
+++ b/config.h
@@ -90,13 +90,13 @@
  *
  *	stty tabs
  */
 unsigned int tabspaces = 8;
 
 /* Terminal colors (16 first used in escape sequence) */
-static const char *colorname[] = {
+static const char *colorsdark[] = {
 	/* 8 normal colors */
 	"black",
 	"red3",
 	"green3",
 	"yellow3",
 	"blue2",
@@ -120,12 +120,44 @@
 	"#cccccc",
 	"#555555",
 	"gray90", /* default foreground colour */
 	"#2B303B", /* default background colour */
 };
 
+/* PaperColor light — matches dwm light mode */
+static const char *colorslight[] = {
+	/* 8 normal colors */
+	"#eeeeee",
+	"#af0000",
+	"#008700",
+	"#5f8700",
+	"#0087af",
+	"#878787",
+	"#005f87",
+	"#444444",
+
+	/* 8 bright colors */
+	"#bcbcbc",
+	"#d70000",
+	"#d70087",
+	"#8700af",
+	"#d75f00",
+	"#d75f00",
+	"#005faf",
+	"#005f87",
+
+	[255] = 0,
+
+	"#444444",
+	"#eeeeee",
+	"#444444", /* default foreground colour */
+	"#eeeeee", /* default background colour */
+};
+
+static const char *const *colorname = colorsdark;
+
 
 /*
  * Default colors (colorname index)
  * foreground, background, cursor, reverse cursor
  */
 unsigned int defaultfg = 258;
